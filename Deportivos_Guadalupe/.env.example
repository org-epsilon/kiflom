# ==============================================================================
# Credenciales Multi-Base de Datos: Deportivos Guadalupe
# ==============================================================================
# NOTA: Este archivo es una plantilla de ejemplo.
# Copia este archivo a .env o .env.deportivos_guadalupe y coloca tus credenciales reales.

# 1. PostgreSQL (Neon.tech)
DATABASE_URL_POSTGRES=postgresql://tu_usuario:tu_password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. MySQL (Aiven.io)
DATABASE_URL_MYSQL=mysql://avnadmin:tu_password@mysql-xyz.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# 3. MongoDB (MongoDB Atlas)
MONGODB_URI=mongodb+srv://tu_usuario:tu_password@cluster0.xyz.mongodb.net/
MONGODB_NAME=deportivos_guadalupe
